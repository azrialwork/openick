-    try: async () => {
-      const result = await fn()
-      if (isSdkResponse<T>(result)) {
-        if (result.error) throw result.error
-        if (result.data !== undefined) return result.data
-      }
-      return result as T
-    },
-    catch: (error) => fromUnknownError(error, service),
