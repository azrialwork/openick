-  )
-}
-
-function selectVariant(variant: string | undefined, variants: readonly string[]) {
-  if (variant && variants.includes(variant)) return variant
-  if (variants.includes(DEFAULT_VARIANT_VALUE)) return DEFAULT_VARIANT_VALUE
-  return variants[0]
-}
