+// (Plan 0007) Native libraries are stripped of symbol and debug data
+// before bundling: the libopentui.so embedded from the OpenTUI platform
+// package carries roughly ten megabytes of symbols the runtime never
+// uses. The strip tool resolves as $OPENICK_STRIP, then llvm-strip,
+// then strip. A missing tool or a failed strip aborts the build: no
+// build silently ships an unstripped library. The compiled binary
+// itself is never stripped; that destroys the embedded payload.
+const stripTool = (() => {
+  for (const candidate of [process.env.OPENICK_STRIP, "llvm-strip", "strip"]) {
+    if (candidate && Bun.which(candidate)) return candidate
+  }
+  return undefined
+})()
+
+async function stripNative(file: string) {
+  if (!stripTool) {
+    console.error(`error: no strip tool found (looked for $OPENICK_STRIP, llvm-strip, strip); cannot strip ${file}`)
+    process.exit(1)
+  }
+  const result = await $`${stripTool} ${file}`.quiet().nothrow()
+  if (result.exitCode !== 0) {
+    console.error(`error: ${stripTool} failed on ${file}: ${result.stderr.toString().trim()}`)
+    process.exit(1)
+  }
+  console.log(`stripped ${file} with ${stripTool}`)
+}
+
+async function opentuiLibPath(item: (typeof allTargets)[number] & { os: string }) {
+  const pkgName =
+    item.os === "android"
+      ? "core-android-arm64"
+      : `core-${item.os}-${item.arch}${item.abi === "musl" ? "-musl" : ""}`
+  const candidates: string[] = []
+  try {
+    const coreDir = (await $`realpath node_modules/@opentui/core`.text()).trim()
+    candidates.push(path.join(path.dirname(coreDir), pkgName, "libopentui.so"))
+  } catch {}
+  candidates.push(path.join(dir, "node_modules", "@opentui", pkgName, "libopentui.so"))
+  candidates.push(path.join(dir, "..", "..", "node_modules", "@opentui", pkgName, "libopentui.so"))
+  for (const candidate of candidates) {
+    if (await Bun.file(candidate).exists()) return candidate
+  }
+  return undefined
+}
+
 await $`rm -rf dist`
 
