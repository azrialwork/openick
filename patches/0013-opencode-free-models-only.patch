# Patch 0013 — OpenCode provider and free models only
#
# Purpose: Restrict the model catalog to the single upstream provider
# this distribution uses. The models.dev registry ships 200+ providers;
# openick keeps only the provider with id "opencode" and, inside it,
# only models whose base cost is free (input and output both zero).
# The rule is data-driven and applied where every catalog source
# converges (disk cache, embedded snapshot, network fetch), so it
# holds for the running binary and for the snapshot embedded at build
# time. Everything that existed only to serve other providers is
# removed with it: the bundled provider SDKs other than
# @ai-sdk/openai-compatible, the per-provider custom loaders, the
# twelve built-in auth plugins for other providers, the GitLab
# workflow model wiring, and the config path that created providers
# from user configuration (which would otherwise re-add any provider
# the catalog no longer ships). The opencode provider's own config
# (options, whitelist, blacklist, variants), the plugin system, and
# user plugins are unchanged. The binary shrinks by about 11.4 MiB.
#
# Upstream files:
#   - packages/core/src/models-dev.ts (catalog restriction in populate)
#   - packages/opencode/script/generate.ts (snapshot filtered at build)
#   - packages/opencode/src/provider/provider.ts (bundled SDK map and
#     custom loaders reduced to the opencode entries, config provider
#     creation removed, small-model priority extended with grok)
#   - packages/opencode/src/plugin/index.ts (no built-in auth plugins)
#   - packages/opencode/src/plugin/{openai,github-copilot,modal}/ and
#     azure.ts, cerebras.ts, cloudflare.ts, digitalocean.ts,
#     snowflake-cortex.ts, xai.ts (deleted)
#   - packages/opencode/src/session/llm.ts and llm/request.ts (GitLab
#     workflow model wiring removed)
#   - packages/opencode/src/cli/cmd/providers.ts (connect flow trimmed
#     to the remaining provider)
#   - packages/tui/src/component/dialog-provider.tsx (custom provider
#     option and OpenCode Go promotion removed)
#   - Tests: provider/plugin/session/server suites repointed at the
#     opencode provider and its free fixture models; tests whose
#     premise was a removed provider or SDK deleted; the test harness
#     now points the opencode provider at the fake LLM server and uses
#     the free fixture model opencode/test-model.
#
# Rebase note: provider.ts is high traffic upstream; the deletions are
# mechanical (drop every BUNDLED_PROVIDERS and custom() entry except
# opencode, drop the config database-extension loop). The catalog
# restriction in models-dev.ts is a single function applied in
# populate(); re-apply it wherever upstream moves catalog assembly.
diff --git a/packages/core/src/models-dev.ts b/packages/core/src/models-dev.ts
index e577935..8f66611 100644
--- a/packages/core/src/models-dev.ts
+++ b/packages/core/src/models-dev.ts
@@ -135,6 +135,25 @@ export const Event = ModelsDev.Event
 
 declare const OPENCODE_MODELS_DEV: Record<string, Provider> | undefined
 
+// The openick delta restricts the product to the OpenCode provider and
+// its free models (Plan 0009). Every catalog source — disk cache,
+// embedded snapshot, network fetch — converges on populate(), so the
+// restriction is applied there and nowhere else needs to know.
+function restrictCatalog(data: Record<string, Provider>): Record<string, Provider> {
+  const provider = data["opencode"]
+  if (!provider) return {}
+  return {
+    opencode: {
+      ...provider,
+      models: Object.fromEntries(
+        Object.entries(provider.models).filter(
+          ([, model]) => (model.cost?.input ?? 0) === 0 && (model.cost?.output ?? 0) === 0,
+        ),
+      ),
+    },
+  }
+}
+
 export interface Interface {
   readonly get: () => Effect.Effect<Record<string, Provider>>
   readonly refresh: (force?: boolean) => Effect.Effect<void>
@@ -228,7 +247,7 @@ const layer = Layer.effect(
         }),
       )
       return JSON.parse(text) as Record<string, Provider>
-    }).pipe(Effect.withSpan("ModelsDev.populate"), Effect.orDie)
+    }).pipe(Effect.map(restrictCatalog), Effect.withSpan("ModelsDev.populate"), Effect.orDie)
 
     const [cachedGet, invalidate] = yield* Effect.cachedInvalidateWithTTL(populate, Duration.infinity)
 
